+    pub async fn get_external_subtitle_url(
+        &self, item_id: &str, media_source_id: &str, stream_index: u64, codec: &str,
+    ) -> String {
+        let url = self.url.lock().await.as_ref().unwrap().to_owned();
+        let extension = match codec {
+            "subrip" => "srt",
+            "webvtt" => "vtt",
+            codec => codec,
+        };
+        let path = format!(
+            "Videos/{}/{}/Subtitles/{}/Stream.{}",
+            item_id, media_source_id, stream_index, extension
+        );
+        let mut url = url.join(&path).unwrap();
+        url.query_pairs_mut().append_pair(
+            "api_key",
+            self.user_access_token.lock().await.as_str(),
+        );
+        url.to_string()
+    }
