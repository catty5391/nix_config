window-rule {
    match app-id="floating_terminal"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.6; }
}

// Override NyxNiri's translucent focused and unfocused window rules.
window-rule {
    opacity 1.0
    background-effect {
        blur false
    }
}

// Noctalia supplies its own rounded blur regions. Its foreground surfaces
// and pop-ups should sample the windows beneath them, avoiding wallpaper
// bleeding through rounded edges with Niri's default xray background.
layer-rule {
    match namespace="^noctalia-" layer="top"
    match namespace="^noctalia-" layer="overlay"
    background-effect {
        xray false
    }
    popups {
        background-effect {
            xray false
        }
    }
}

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}
